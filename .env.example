# 2026-11-09 研究补位策略使用现有采集证据，无新增环境参数。
# 周报每自然周唯一：V23 自动迁移；重新生成覆盖同周内容，无新增环境参数。
DB_URL=jdbc:mysql://localhost:3306/iaa_radar?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
DB_USERNAME=iaa
DB_PASSWORD=change-me
BUSINESS_TIMEZONE=Asia/Shanghai
MATERIAL_DIR=./data/materials
# 缩略图实际文件目录；与原始材料一起备份。部署环境使用绝对路径。
ICON_DIR=./data/icons
APP_CONFIG_ENCRYPTION_KEY=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
SOURCE_WECHAT_SECRET_REF=
SOURCE_DOUYIN_SECRET_REF=
SOURCE_IOS_SECRET_REF=
SOURCE_GOOGLE_PLAY_SECRET_REF=

# 市场洞察：部署单实例Java定时器，Asia/Shanghai。开发默认关闭。
INSIGHT_DAILY_ENABLED=false
INSIGHT_DAILY_CRON=0 0 8 * * *
# 服务器网络能正常访问AppBrain后才启用四国自动取材。
INSIGHT_APPBRAIN_ENABLED=false
INSIGHT_WEEKLY_ENABLED=false
INSIGHT_WEEKLY_CRON=0 0 9 * * MON
INSIGHT_WEEKLY_REVIEW_CRON=0 0 17 * * FRI

# 单组织工作区：按业务需要填写访问口令；留空时浏览器直接进入工作区，不启用用户体系。
# 配置口令后才会启用HttpOnly会话，自动调用使用Bearer令牌；切勿提交真实值。
PROFILE_TENANT_ID=default
PROFILE_ACCESS_TOKEN=

# 独立榜单采集：只写external_*采集表，不触发产品/规则/周报。
CAPTURE_MATERIAL_DIR=./data/external-captures
# 配置后微信/抖音改用持久浏览器会话且要求每榜连续Top100；先运行登录脚本。
CAPTURE_BROWSER_PROFILE_DIR=
CAPTURE_BROWSER_CHANNEL=chrome
CAPTURE_BROWSER_HEADLESS=true
# 点点扩展资料专用会话，独立于引力引擎。配置后启用 --profiles-worker。
# 服务器通过 scripts/server-diandian-login.sh start/finish 手动登录并原地保存。
CAPTURE_DIANDIAN_PROFILE_DIR=
# Spring执行器每分钟检查数据库计划；计划默认关闭，在信息抓取页面启用。
# Windows登录自启动执行器使用--worker，不依赖Spring开关。二者可共存，DB租约防重。
# 生产使用独立systemd worker时设false，避免Web进程重复调度。服务器会话须就地手动登录，不转移Cookie。
CAPTURE_WORKER_ENABLED=true
# 旧RANKING_CAPTURE_ENABLED/CRON已被V14持久化计划替代，不再读取。

# 前后端开发端口不同时，填写准确的Origin列表，禁止通配符。
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 服务器同步回执和心跳目录；不在此文件存储SSH或浏览器会话。
CAPTURE_SYNC_RECEIPT_DIR=./data/deliveries

# 2026-11-03 早期机会组合无需新增凭据/开关；配额与证据阈值按版本冻结，见 docs/15-EARLY-OPPORTUNITY-MODEL.md。

# 生产内存边界配置在 scripts/systemd（Web1280/采集1536/报告桥512MiB），不是.env变量；见 docs/14。

# V16 产品关联与跨平台研究无需新增参数；继续使用PROFILE_TENANT_ID隔离，身份/玩法核验在页面带证据提交。

# V17: Google Play由GitHub Actions采集，无新增服务器.env密钥。
# GitHub Repository Secrets: OVERSEAS_CAPTURE_TOKEN / OVERSEAS_CAPTURE_CA_CERT。
# 仅用于HTTPS受限材料接收；不要填写root密码、JDBC、AI Key或浏览器Cookie。

# 2026-11-03 周报页面投影/加载修复无新增参数；gzip部署片段见 scripts/nginx/report-response-gzip.conf。

# V18 在线网页采集：只有此确切地址允许内部HTTP；其他服务/目标仅公开HTTPS。
CAPTURE_FIRECRAWL_INTERNAL_URL=
# 配置供应商API Key时必填独立长随机加密密钥；不可丢失或随意更换。
CAPTURE_TOOL_ENCRYPTION_KEY=

# Independent overseas metric delivery token, generated on server; never reuse browser or provider credentials.
CAPTURE_REMOTE_METRIC_TOKEN=
# 精选配额1/2/2由Skill2.7.0和Java确定性规则管理，无新增环境变量。
