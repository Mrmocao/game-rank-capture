[Unit]
Description=IAA server browser ranking capture worker
After=network-online.target iaa-radar.service
Wants=network-online.target

[Service]
Type=simple
User=iaa-radar
Group=iaa-radar
WorkingDirectory=/opt/iaa-radar/shared
EnvironmentFile=/etc/iaa-radar/app.env
ExecStart=/usr/bin/java -Xmx192m -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8 -Dloader.main=com.youkia.iaa.collection.capture.RankingCaptureCommand -cp /opt/iaa-radar/current/iaa-radar-api-0.1.0-SNAPSHOT.jar org.springframework.boot.loader.launch.PropertiesLauncher --worker --env-file /opt/iaa-radar/shared/capture-worker.env
Restart=on-failure
RestartSec=20
MemoryMax=1G
TasksMax=256
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=multi-user.target

