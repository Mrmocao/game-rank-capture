{
  "schemaVersion": "portal-field-template-1.0.0",
  "fieldCount": 28,
  "fields": [
    {
      "field_key": "native_game_id",
      "字段名称": "站内游戏ID",
      "采集与口径": "网页原生ID；无则使用来源内canonical_url，不拿名称当键"
    },
    {
      "field_key": "canonical_url",
      "字段名称": "详情与试玩入口",
      "采集与口径": "去掉跟踪参数但保留游戏ID/语言等业务参数；跨域试玩仅记链接待核"
    },
    {
      "field_key": "title",
      "字段名称": "名称与别名",
      "采集与口径": "保留原文、语言和别名来源"
    },
    {
      "field_key": "developer",
      "字段名称": "开发/发行主体",
      "采集与口径": "来源明确才填；分发方不自动当原始开发者"
    },
    {
      "field_key": "description",
      "字段名称": "介绍与玩法",
      "采集与口径": "官方/站点描述与AI玩法总结分开"
    },
    {
      "field_key": "genre_tags",
      "字段名称": "分类与标签",
      "采集与口径": "原分类与内部玩法家族分开"
    },
    {
      "field_key": "controls",
      "字段名称": "操作与输入",
      "采集与口径": "触屏/鼠标/键盘等按页面声明或实测"
    },
    {
      "field_key": "runtime_type",
      "字段名称": "运行形态",
      "采集与口径": "HTML5/WebGL/Flash/下载/云游戏/未知，不能由URL后缀猜"
    },
    {
      "field_key": "device_support",
      "字段名称": "设备适配",
      "采集与口径": "手机/桌面兼容按游戏声明及实测，不能只因站点移动域名确认"
    },
    {
      "field_key": "orientation",
      "字段名称": "屏幕方向",
      "采集与口径": "横/竖屏/未知；依据声明或观察"
    },
    {
      "field_key": "site_added_at",
      "字段名称": "本站收录日期",
      "采集与口径": "不是全球首发日期；与first_seen和release_at分开"
    },
    {
      "field_key": "source_release_at",
      "字段名称": "来源声明上线日期",
      "采集与口径": "保留来源与适用版本，不推全平台"
    },
    {
      "field_key": "source_updated_at",
      "字段名称": "来源更新日期",
      "采集与口径": "记录页面标识，不能拿抓取时间替代"
    },
    {
      "field_key": "list_name",
      "字段名称": "目录/榜单/推荐位名称",
      "采集与口径": "新游/编辑推荐/人气/游玩榜/个人推荐分别登记"
    },
    {
      "field_key": "list_position",
      "字段名称": "榜单名次或展示位置",
      "采集与口径": "只有来源明示名次才写rank；普通网格序号写display_position"
    },
    {
      "field_key": "ranking_window",
      "字段名称": "榜单统计窗口",
      "采集与口径": "周/月/累计/未知；不能由本周抓取推本周榜"
    },
    {
      "field_key": "rating_display",
      "字段名称": "站内评分与量表",
      "采集与口径": "保存原标签/量表/窗口；未知量表不默认5分"
    },
    {
      "field_key": "rating_count",
      "字段名称": "投票/赞踩/评分计数",
      "采集与口径": "原始显示和精确度分别保留，不当文字评论数量"
    },
    {
      "field_key": "play_count_display",
      "字段名称": "站内游玩计数",
      "采集与口径": "次数/人在玩语义与统计窗不明就不换算独立玩家、DAU或下载"
    },
    {
      "field_key": "review_sample",
      "字段名称": "可见玩家评论",
      "采集与口径": "仅明确可见正文采样；不可见不造样本；保存排序/分页"
    },
    {
      "field_key": "media_links",
      "字段名称": "图标/截图/视频入口",
      "采集与口径": "优先引用链接，转存及AI分析受逐源策略约束"
    },
    {
      "field_key": "ad_signal",
      "字段名称": "广告线索",
      "采集与口径": "站点广告、游戏内广告、激励视频分开，不能证明纯IAA"
    },
    {
      "field_key": "payment_signal",
      "字段名称": "内购/付费/订阅/捐赠",
      "采集与口径": "以目标网页版本证据记录，不从免费可玩排除付款"
    },
    {
      "field_key": "monetization_status",
      "字段名称": "变现资格",
      "采集与口径": "默认unknown；有依据才能确认目标版本纯IAA"
    },
    {
      "field_key": "cross_site_relation",
      "字段名称": "跨站同款与原始发布关系",
      "采集与口径": "同名、相似截图仅提关联；开发者、原发布与分发ID等强证据复核"
    },
    {
      "field_key": "evidence_scope",
      "字段名称": "证据与覆盖",
      "采集与口径": "原URL、片段、来源版本、观察/可用时间、实际深度、缺口、解析版本"
    },
    {
      "field_key": "distribution_family",
      "字段名称": "根来源与分发族",
      "采集与口径": "同一开发商/分发包跨门户出现不当独立成功证据"
    },
    {
      "field_key": "research_hypothesis",
      "字段名称": "迁移与制作假设",
      "采集与口径": "手机操作、广告点、工期等AI提议需实机/团队验证"
    }
  ]
}
